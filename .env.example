# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback, used if Gemini fails. Free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional
# AICOMMIT_MODEL=gemini-3.8-flash
# AICOMMIT_GROQ_MODEL=qwen/qwen3.8-27b
# AICOMMIT_MAX_INPUT_TOKENS=16000
# Override cost estimates (USD per 1M tokens)
# AICOMMIT_PRICE_INPUT=0.75
# AICOMMIT_PRICE_OUTPUT=3.75
# AICOMMIT_GROQ_PRICE_INPUT=0.80
# AICOMMIT_GROQ_PRICE_OUTPUT=4.00
